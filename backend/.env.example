# --- Server ---
PORT=4000
NODE_ENV=development

# --- Base de datos ---
# IMPORTANTE: usar SESSION-MODE pooler (puerto 5432). NO uses transaction-mode
# (puerto 6543 + ?pgbouncer=true) porque Prisma 7 + adapter-pg falla con
# "Authentication failed" por incompatibilidad con prepared statements.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Cadena directa (también session-mode) — sirve para migraciones e introspection.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Seguridad ---
# OBLIGATORIO. Generá una clave aleatoria y NO reutilices la de desarrollo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-clave-segura

# --- Frontend ---
# Orígenes permitidos por CORS (lista separada por comas). En producción tiene
# que ser la URL HTTPS del Static Site de Render.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# URL base del frontend. Se usa para derivar las back_urls de Mercado Pago
# cuando no se definen las tres variables MP_RETURN_URL_* siguientes.
FRONTEND_URL=http://localhost:5173

# --- Mercado Pago (Sandbox) ---
# IMPORTANTE: estos secretos viven SOLO en el backend. Nunca en el frontend ni
# en variables VITE_* (todo VITE_* se incrusta en el bundle y es público).
# Access token de Mercado Pago (panel → Developers → Credentials).
MP_ACCESS_TOKEN=
# ID del recolector/cuenta que emite los cobros. El webhook compara contra este
# valor para descartar pagos de otras cuentas.
MP_COLLECTOR_ID=

# Destinos a los que Mercado Pago devuelve al usuario al terminar el checkout.
# Si se dejan vacíos, se derivan de FRONTEND_URL + las rutas internas
# `/pago/exito` | `/pago/pendiente` | `/pago/fallo`, que el frontend monta
# para confirmar el pago contra la API y luego redirigir a `/user/reservar`.
MP_RETURN_URL_SUCCESS=
MP_RETURN_URL_PENDING=
MP_RETURN_URL_FAILURE=

# URL a la que MP envía las notificaciones de pago. La consume el SERVIDOR
# de MP, así que debe ser alcanzable desde internet. En producción usá la URL
# pública del Web Service (p. ej. https://gestion-de-reservas-1.onrender.com
# /api/payments/webhook). Si la dejas apuntando a localhost, el webhook
# nunca llega, pero el flujo de pago igual funciona porque la pantalla de
# retorno consulta GET /api/payments/estado y confirma el pago contra la
# API de Mercado Pago.
MP_NOTIFICATION_URL=http://localhost:4000/api/payments/webhook

# --- Vencimiento de reservas pendientes de pago ---
# Plazo para completar el pago antes de liberar el turno (3 minutos por
# defecto). Lo aplica el backend (jobs/index.js), no el frontend.
RESERVATION_EXPIRATION_MS=180000
# Frecuencia con la que corre el barrido que cancela reservas vencidas.
RESERVATION_SWEEP_INTERVAL_MS=30000
